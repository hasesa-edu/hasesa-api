# "development" or "production".
ENVIRONMENT=development

# Neon Postgres. The app uses the POOLED connection string (host contains
# "-pooler"). Alembic migrations use the DIRECT one. Copy both from the Neon
# console > Connection details. "?sslmode=require" is fine; it is handled.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Connection pool per instance (long-running hosts such as a container). Keep
#   max instances x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# below Neon's pooler limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# true = a fresh connection per request, no pool. Use on Vercel (serverless).
DB_NULL_POOL=false

# Comma-separated browser origins allowed to call the API directly.
# The web app calls from its server, so this is only for browser clients.
CORS_ORIGINS=http://localhost:3000

# Public base URL of this API (token issuer; Google redirect base).
API_BASE_URL=http://localhost:8000

# ---- Hasesa Accounts ----
# Generate all of these with:  uv run python -m hasesa_api.identity.keygen
# Without them, development uses a temporary key; production refuses to start sign-ins.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
REFRESH_TOKEN_SECRET=
# Confidential clients' secrets: client_id:secret,client_id:secret
CLIENT_SECRETS=

# Google OAuth client (the same one the web app uses). Register
#   <API_BASE_URL>/v1/auth/google/callback
# as an authorized redirect URI on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Android/iOS Google client IDs whose ID tokens are accepted (comma-separated).
GOOGLE_NATIVE_CLIENT_IDS=

# Emails of the people who run Hasesa (comma-separated). They sign in with
# Google and get the admin tools (/v1/admin/*).
ADMIN_EMAILS=

# Chapa payments: the CHASECK_TEST-... key on Preview, the live key on Production.
# Webhook URL in the Chapa dashboard: <API_BASE_URL>/v1/billing/chapa/webhook
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Lab assistant: any OpenAI-compatible chat completions API. Defaults to Groq.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_REASONING_EFFORT=

# Database tests (pytest) use this throwaway database; never production.
TEST_DATABASE_URL=
