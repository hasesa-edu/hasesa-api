# "development" or "production".
ENVIRONMENT=development

# Neon Postgres. The app uses the POOLED connection string (host contains
# "-pooler"). Alembic migrations use the DIRECT one. Copy both from the Neon
# console > Connection details. "?sslmode=require" is fine; it is handled.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Connection pool per instance (long-running hosts such as a container). Keep
#   max instances x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# below Neon's pooler limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# true = a fresh connection per request, no pool. Use on Vercel (serverless).
DB_NULL_POOL=false

# Comma-separated browser origins allowed to call the API directly.
# The web app calls from its server, so this is only for browser clients.
CORS_ORIGINS=http://localhost:3000
